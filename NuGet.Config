<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- PackageSourceMapping: asegurar que paquetes comunes se puedan resolver desde nuget.org
       Aquí se mapea '*' a nuget.org para evitar bloqueos por configuraciones globales que
       limitan qué paquetes pueden resolverse desde qué orígenes. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
