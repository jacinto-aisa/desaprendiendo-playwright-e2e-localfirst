@page
@model CursosEtiquetasModel
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta content="width=device-width, initial-scale=1" name="viewport">
<title>Cursos etiquetas · Jacinto Aisa Ibañez</title>
<link href="/assets/css/cursos.css" rel="stylesheet">
</head>
<body>
    <div class="nav"> ... </div>
    <div class="container">
      <div class="hero">
        <h1>Listado de cursos por etiquetas</h1>
        <p>Explora las etiquetas y los cursos que las usan.</p>
      </div>

      <section id="kpis">
        <div class="kpi">Cursos: @Model.Data.Courses.Count</div>
        <div class="kpi">Etiquetas: @Model.Data.TagCategories.Values.SelectMany(x => x).Distinct().Count()</div>
      </section>

      <section id="tag-categories">
        @foreach (var cat in Model.Data.TagCategories)
        {
            <div class="tag-category">
                <h2>@cat.Key</h2>
                <ul class="tag-list">
                @foreach (var tag in cat.Value)
                {
                    <li class="tag-item"><a href="#" data-tag="@tag">@tag</a></li>
                }
                </ul>
            </div>
        }
      </section>

      <section id="courses-list">
        @foreach (var course in Model.Data.Courses)
        {
            <article class="course">
                <h3>@course.Title</h3>
                <div class="meta">@course.Client · @course.Year</div>
                <div class="course-tags">@string.Join(", ", course.Tags)</div>
            </article>
        }
      </section>

    </div>

  <script>
    // Expose SITE_DATA for progressive enhancement where client scripts still expect it
    @Html.Raw(Model.SiteDataScript)
  </script>
  <!-- Client scripts removed: UI now server-rendered -->
</body>
</html>
