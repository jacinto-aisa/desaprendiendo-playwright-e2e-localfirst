@page 
@model CursosGraphModel
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cursos graph · Jacinto Aisa Ibañez</title>
  <link rel="stylesheet" href="/assets/css/cursos.css">
  <link rel="stylesheet" href="/assets/css/cursos_graph.css">
</head>
<body class="cursosGraph">
  <div class="nav"> ... <!-- truncated for brevity: navigation same as original -->
  </div>

  <div class="container">
    <div class="hero">
      <h1>Mapa de etiquetas (burbujas)</h1>
      <p>Las etiquetas más usadas aparecen con mayor tamaño.</p>
    </div>

    <section id="bubbles">
      <ul class="bubble-list">
        @foreach (var kv in Model.TagCounts.OrderByDescending(k => k.Value))
        {
            var tag = kv.Key;
            var count = kv.Value;
            var sizeClass = count >= 5 ? "bubble-large" : (count >= 2 ? "bubble-medium" : "bubble-small");
            <li class="bubble @sizeClass" data-tag="@tag" title="@tag (@count cursos)">@tag <span class="count">@count</span></li>
        }
      </ul>
    </section>

    <section id="graph-legend">
      <h2>Leyenda</h2>
      <ul>
        <li><span class="badge bubble-large"></span> 5+ cursos</li>
        <li><span class="badge bubble-medium"></span> 2-4 cursos</li>
        <li><span class="badge bubble-small"></span> 1 curso</li>
      </ul>
    </section>
  </div>
  <!-- SITE_DATA injected for compatibility but client scripts removed: UI rendered server-side -->
  <script>
    @Html.Raw(Model.SiteDataScript)
  </script>
</body>
</html>
