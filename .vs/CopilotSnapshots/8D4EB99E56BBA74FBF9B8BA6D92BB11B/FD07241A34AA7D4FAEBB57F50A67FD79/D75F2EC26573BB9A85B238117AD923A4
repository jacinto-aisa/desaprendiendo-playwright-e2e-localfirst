import fs from 'node:fs';
import path from 'node:path';

const rutas = [
  '.nyc_output',
  path.join('coverage', 'e2e'),
  'web-local-instrumented',
  'api-local-instrumented',
];

for (const ruta of rutas) {
  fs.rmSync(path.resolve(ruta), {
    recursive: true,
    force: true,
  });
}

console.log('Cobertura e2e limpiada.');
