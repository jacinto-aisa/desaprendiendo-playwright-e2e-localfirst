import { test,expect } from '@fixtures/AppFixtures';
import { testsPorEntorno } from '@support/DecoradorTestPorEntorno';

test.describe('navegacion principal', () => {
  test.beforeEach(async ({pagInicio}) => {
    expect(await pagInicio.open()).toBeTruthy();
  });

  test('permite navegar a Certificaciones desde el menú', async ({  cabecera, pagCertificaciones }) => {
    await cabecera.irACertificaciones();
    await expect(pagCertificaciones.titulo()).toBeVisible();
  });
  test('permite navegar a Clientes desde el menú', async ({  cabecera, pagClientes }) => {
    await cabecera.irAClientes();
    await expect(pagClientes.titulo()).toBeVisible();
  });

  test('permite navegar a Experiencia desde el menú', async ({  cabecera, pagExperiencia }) => {
    await cabecera.irAExperiencia();
    await expect(pagExperiencia.titulo()).toBeVisible();
  });
  test('permite navegar a Método desde el menú', async ({  cabecera, pagMetodo }) => {
    await cabecera.irAMetodo();
    await expect(pagMetodo.titulo()).toBeVisible();
  });
});
