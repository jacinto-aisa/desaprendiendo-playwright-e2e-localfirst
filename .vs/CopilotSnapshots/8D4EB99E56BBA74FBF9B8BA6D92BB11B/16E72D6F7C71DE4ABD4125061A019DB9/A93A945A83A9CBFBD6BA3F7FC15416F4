<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.43.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>

  <!-- Automatic installation of Playwright browsers before build -->
  <Target Name="EnsurePlaywrightBrowsersInstalled" BeforeTargets="Build">
    <!-- Try to install the Playwright CLI (if missing). ContinueOnError = true hides the error
         if the tool is already installed or the environment doesn't allow global installs. -->
    <Exec Command="dotnet tool install --global Microsoft.Playwright.CLI --version 1.43.0" ContinueOnError="true" />
    <!-- Install browser binaries required by Microsoft.Playwright -->
    <Exec Command="playwright install" />
  </Target>

</Project>
