import { expect, Locator, Page } from "@playwright/test";

export abstract class PaginaBase {
  protected constructor(
    protected readonly page: Page,
    private readonly ruta: string,
    private readonly tituloEsperado: string | RegExp
  ) {}

  async open(): Promise<boolean> {
    const response = await this.page.goto(this.ruta);
    return response?.ok() ?? false;
  }

  titulo(): Locator {
    return this.page.getByRole('heading', {
      name: this.tituloEsperado,
    });
  }

  async deberiaEstarCargada(): Promise<void> {
    await expect(this.titulo()).toBeVisible();
  }

  async abrirYComprobar(): Promise<void> {
    expect(await this.open()).toBeTruthy();
    await this.deberiaEstarCargada();
  }

  rutaEsperada(): string {
    return this.ruta;
  }
}
