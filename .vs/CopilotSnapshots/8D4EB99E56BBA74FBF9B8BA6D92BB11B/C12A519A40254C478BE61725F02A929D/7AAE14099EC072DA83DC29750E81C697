document.addEventListener("DOMContentLoaded", function(){

  if(typeof window.SITE_DATA === "undefined") return;

  const data = window.SITE_DATA;

  const courses = Array.isArray(data.courses) ? data.courses.length : 0;
  const clients = Array.isArray(data.clients) ? data.clients.length : 0;
  const experience = Array.isArray(data.experience) ? data.experience.length : 0;
  const certs = Array.isArray(data.certifications) ? data.certifications.length : 0;

  const set = (id,val)=>{
    const el = document.getElementById(id);
    if(el) el.textContent = val;
  };

  set("kpiCourses", courses);
  set("kpiClients", clients);
  set("kpiExperience", experience);
  set("kpiCerts", certs);

});


// ===============================
// Smart KPIs + smooth counter (Local First)
// ===============================
(function(){
  function num(n){ return (typeof n === 'number' && isFinite(n)) ? n : (isFinite(parseFloat(n)) ? parseFloat(n) : 0); }
  function uniq(arr){ return Array.from(new Set(arr.filter(Boolean))); }
  function yearsFromDates(dates){
    const s = String(dates||'');
    const ys = (s.match(/\b\d{4}\b/g) || []).map(x=>parseInt(x,10)).filter(x=>x>1900 && x<3000);
    return ys;
  }
  function formatInt(n){
    try { return new Intl.NumberFormat('es-ES').format(Math.round(n)); }
    catch(_e){ return String(Math.round(n)); }
  }
  function animateCount(el, target, opts){
    opts = opts || {};
    const dur = opts.duration || 900;
    const suffix = opts.suffix || '';
    const start = 0;
    const t0 = performance.now();
    function tick(t){
      const p = Math.min(1, (t - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3); // easeOutCubic
      const v = start + (target - start) * e;
      el.textContent = formatInt(v) + suffix;
      if(p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  document.addEventListener('DOMContentLoaded', function(){
    if(typeof window.SITE_DATA === 'undefined') return;
    const data = window.SITE_DATA;

    const courses = Array.isArray(data.courses) ? data.courses : [];
    const clientsArr = Array.isArray(data.clients) ? data.clients : [];
    const exp = Array.isArray(data.experience) ? data.experience : [];
    const certs = Array.isArray(data.certifications) ? data.certifications : [];

    const totalCourses = courses.length;
    const totalHours = courses.reduce((acc,c)=> acc + num(c.total_hours || c.hours || 0), 0);
    const techs = uniq(courses.flatMap(c => {
      const raw = Array.isArray(c.tags) ? c.tags : (c.type ? [c.type] : []);
      return raw.map(x=>String(x||'').trim()).filter(t=>t && t!=='—');
    }));
    const courseClients = uniq(courses.map(c => String(c.client||'').trim()).filter(Boolean));
    const totalClients = Math.max(clientsArr.length, courseClients.length);

    // Experience years
    let years = [];
    exp.forEach(e => years = years.concat(yearsFromDates(e.dates)));
    if(!years.length){
      courses.forEach(c => { const y = parseInt(c.year,10); if(y) years.push(y); });
    }
    const nowY = (new Date()).getFullYear();
    const minYear = years.length ? Math.min.apply(null, years) : nowY;
    const expYears = Math.max(1, nowY - minYear + 1);

    const set = (id,val,opts)=>{
      const el = document.getElementById(id);
      if(!el) return;
      animateCount(el, val, opts);
    };

    set('kpiCourses', totalCourses);
    set('kpiHours', totalHours, {suffix:'h'});
    set('kpiClients', totalClients);
    set('kpiTech', techs.length);
    set('kpiExpYears', expYears);

    // If somewhere else you have certs KPI, keep it updated too
    const elCert = document.getElementById('kpiCerts');
    if(elCert) animateCount(elCert, certs.length);
  });
})();

