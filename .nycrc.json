{
  "temp-dir": ".nyc_output",
  "report-dir": "coverage/e2e",
  "all": true,
  "include": ["src/**/*.{js,jsx,ts,tsx}"],
  "exclude": [
    "tests/**",
    "e2e/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "node_modules/**"
  ],
  "reporter": ["html", "lcov", "text-summary"],
  "check-coverage": false
}
